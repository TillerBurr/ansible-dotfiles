theme = Catppuccin Frappe
shell-integration = zsh
font-family = JetBrainsMono Nerd Font Mono
mouse-hide-while-typing = true
scrollback-limit = 100000000

keybind = ctrl+n=new_window

keybind = unconsumed:ctrl+h=goto_split:left
keybind = unconsumed:ctrl+j=goto_split:bottom
keybind = unconsumed:ctrl+k=goto_split:top
keybind = unconsumed:ctrl+l=goto_split:right

keybind = ctrl+a>h=new_split:left
keybind = ctrl+a>j=new_split:down
keybind = ctrl+a>k=new_split:up
keybind = ctrl+a>l=new_split:right
keybind = ctrl+a>f=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits

keybind = cmd+ctrl+h=resize_split:left,20
keybind = cmd+ctrl+l=resize_split:right,20
keybind = cmd+ctrl+=resize_split:up,10
keybind = cmd+ctrl+k=resize_split:down,10

keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab
keybind = ctrl+a>t=new_tab

keybind = super+r=reload_config

window-save-state = always

keybind = global:ctrl+grave_accent=toggle_quick_terminal

window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-padding-color = extend
font-feature = calt
font-feature = liga
font-codepoint-map = U+2500-U+259F=Menlo
macos-titlebar-style = transparent
window-decoration = auto
window-theme = dark
window-colorspace = display-p3
window-save-state = always

# critical: hide ghostty's tab bar — cmux provides its own vertical tabs
window-show-tab-bar = never


# --- split panes -----------------------------------------------------------
# dimmed unfocused panes help you instantly see which agent you're
# interacting with. essential when running 3-4 agents side by side.
unfocused-split-opacity = 0.65
unfocused-split-fill = 181825
split-divider-color = 45475a

# new splits/tabs inherit the working directory — saves cd-ing every time
split-inherit-working-directory = true
tab-inherit-working-directory = true
window-inherit-working-directory = true
window-inherit-font-size = true

# --- clipboard -------------------------------------------------------------
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
copy-on-select = clipboard

# word navigation (option+arrow): jump word-by-word in zsh/bash
keybind = alt+left=esc:b
keybind = alt+right=esc:f

# line navigation (cmd+arrow): beginning/end of line
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05

# delete word backward (option+backspace)
keybind = alt+backspace=text:\x17
keybind = cmd+equal=increase_font_size:2
keybind = cmd+minus=decrease_font_size:2
keybind = cmd+0=reset_font_size
keybind = cmd+shift+comma=reload_config
keybind = cmd+enter=toggle_fullscreen
